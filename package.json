{
  "name": "sanverse-animated-excalidraw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run mcp:build-cloud-ui && vinext build",
    "start": "vinext start",
    "standalone:dev": "vite --config vite.standalone.config.ts",
    "standalone:build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build --config vite.standalone.config.ts",
    "lint": "oxlint",
    "pretest": "npm run mcp:build-ui",
    "test": "vitest run",
    "test:hosted": "npm run build && node --test tests/rendered-html.test.mjs",
    "mcp:build-ui": "vite build --config vite.mcp-app.config.ts",
    "mcp:build-cloud-ui": "vite build --config vite.mcp-cloud-app.config.ts",
    "premcp:start": "npm run mcp:build-ui",
    "mcp:start": "tsx mcp/server.ts",
    "premcp:test": "npm run mcp:build-ui",
    "mcp:test": "vitest run mcp/server.test.ts",
    "mcp:check": "tsc -p mcp/tsconfig.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@imgly/background-removal": "^1.7.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "express": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.3",
    "@cloudflare/vite-plugin": "1.51.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxlint": "^1.71.0",
    "tsx": "4.20.5",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  }
}
