    "preview": "vite preview",
    "mcp:build-ui": "vite build --config vite.mcp-app.config.ts",
    "premcp:start": "npm run mcp:build-ui",
    "mcp:start": "tsx mcp/server.ts",
    "premcp:test": "npm run mcp:build-ui",
    "mcp:test": "vitest run mcp/server.test.ts",
    "mcp:check": "tsc -p mcp/tsconfig.json"
